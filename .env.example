# Local development credentials only. Copy to .env (git-ignored) and change the values.
# Docker compose reads .env automatically; services started from the IDE need the same variables.

MYSQL_ROOT_PASSWORD=change-me-root
ORDER_INTAKE_DB_PASSWORD=change-me-intake
ORDER_MANAGEMENT_DB_PASSWORD=change-me-management
NOTIFICATION_DB_PASSWORD=change-me-notification

RABBITMQ_ADMIN_PASSWORD=change-me-admin
ORDER_INTAKE_RABBITMQ_PASSWORD=change-me-intake
ORDER_MANAGEMENT_RABBITMQ_PASSWORD=change-me-management
NOTIFICATION_RABBITMQ_PASSWORD=change-me-notification

REDIS_PASSWORD=change-me-redis

CONFIG_SERVER_PASSWORD=change-me-config

KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak
# Must match the secret of the order-management client in infra/keycloak/melita-realm.json.
ORDER_MANAGEMENT_CLIENT_SECRET=order-management-local-secret

# 32 random bytes, base64. Generate your own with: openssl rand -base64 32
PII_ENCRYPTION_KEY=q83vEjRFV4m5nSdQ4TDTRMfbe1WYN1kMm9gTzqOpdq0=
