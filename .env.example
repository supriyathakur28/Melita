# Local development credentials only. Copy to .env (git-ignored) and change the values.
# Docker compose reads .env automatically; services started from the IDE need the same variables.

MYSQL_ROOT_PASSWORD=change-me-root
ORDER_INTAKE_DB_PASSWORD=change-me-intake
ORDER_APPROVAL_DB_PASSWORD=change-me-management
CARE_DB_PASSWORD=change-me-care
FULFILMENT_DB_PASSWORD=change-me-fulfilment

RABBITMQ_ADMIN_PASSWORD=change-me-admin
ORDER_INTAKE_RABBITMQ_PASSWORD=change-me-intake
ORDER_APPROVAL_RABBITMQ_PASSWORD=change-me-management
CARE_RABBITMQ_PASSWORD=change-me-care

REDIS_PASSWORD=change-me-redis

CONFIG_SERVER_PASSWORD=change-me-config

KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak
# Must match the secret of the order-approval client in infra/keycloak/melita-realm.json.
ORDER_APPROVAL_CLIENT_SECRET=order-approval-local-secret

# Field-encryption keys, one per service that stores ID numbers: 32 random bytes, base64.
# Generate your own with: openssl rand -base64 32
PII_ENCRYPTION_KEY=q83vEjRFV4m5nSdQ4TDTRMfbe1WYN1kMm9gTzqOpdq0=
