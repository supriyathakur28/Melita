<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Coding conventions enforced on every build (main and test code):
  - every local variable and every method or constructor parameter is final;
  - one variable per declaration.
  A variable that is genuinely reassigned (e.g. a loop counter) is allowed to stay non-final.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <module name="TreeWalker">
        <module name="FinalLocalVariable">
            <property name="validateEnhancedForLoopVariable" value="true"/>
        </module>
        <module name="FinalParameters">
            <property name="tokens" value="METHOD_DEF, CTOR_DEF"/>
        </module>
        <module name="MultipleVariableDeclarations"/>
    </module>
</module>
