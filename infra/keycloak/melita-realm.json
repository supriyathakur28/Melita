{
  "realm": "melita",
  "displayName": "Melita order platform (LOCAL DEVELOPMENT ONLY)",
  "enabled": true,
  "accessTokenLifespan": 300,
  "sslRequired": "none",
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {
        "name": "AGENT",
        "description": "Views and decides orders awaiting approval"
      },
      {
        "name": "SUPERVISOR",
        "description": "Agent plus policy view",
        "composite": true,
        "composites": {
          "realm": [
            "AGENT"
          ]
        }
      }
    ]
  },
  "clientScopes": [
    {
      "name": "orders:write",
      "description": "Place orders",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "orders:read",
      "description": "Read own orders and the catalogue",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "fulfilment:submit",
      "description": "Submit orders to Fulfilment",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "roles",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "profile",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": [
    "basic",
    "roles",
    "profile"
  ],
  "clients": [
    {
      "clientId": "erp-partner",
      "name": "Partner erp-partner",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "erp-partner-local-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "audience-order-intake",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "order-intake-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "partner-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "partner_id",
            "claim.value": "erp-partner",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "orders:write",
        "orders:read"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "other-partner",
      "name": "Partner other-partner",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "other-partner-local-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "audience-order-intake",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "order-intake-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "partner-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "partner_id",
            "claim.value": "other-partner",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "orders:write",
        "orders:read"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "order-approval",
      "name": "order-approval-service (calls Fulfilment)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "order-approval-local-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "audience-fulfilment",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "fulfilment-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "fulfilment:submit",
        "basic"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "agent-console",
      "name": "Agent console - LOCAL REALM ONLY (password grant for Postman/CI)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "audience-order-approval",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "order-approval-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "basic",
        "roles",
        "profile"
      ],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "agent1",
      "enabled": true,
      "firstName": "Anna",
      "lastName": "Agent",
      "email": "agent1@melita.example",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "agent1-password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "AGENT"
      ]
    },
    {
      "username": "supervisor1",
      "enabled": true,
      "firstName": "Sam",
      "lastName": "Supervisor",
      "email": "supervisor1@melita.example",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "supervisor1-password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "SUPERVISOR"
      ]
    }
  ]
}
